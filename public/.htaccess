<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  SetEnvIf Request_URI "^/.*/?_next/static/" MMF_NEXT_STATIC=1
  Header always set Cache-Control "public, max-age=31536000, immutable" env=MMF_NEXT_STATIC
</IfModule>
